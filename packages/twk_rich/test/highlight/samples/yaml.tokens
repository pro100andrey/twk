"  " key"push" punctuation":"
"    " key"branches" punctuation":" " " punctuation"[" string"main" punctuation"," " " string"'release/*'" punctuation"]"
"  " key"pull_request" punctuation":" " " punctuation"{" key"types" punctuation":" " " punctuation"[" string"opened" punctuation"," " " string"synchronize" punctuation"]}"

