{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "types": ["node", "mocha"]
  },
  "include": ["src"],
  "exclude": ["src/webview/main.ts", "src/webview/log.ts"]
}
